<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/jarvis_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="@color/jarvis_cyan"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:text="Connected service: AI backend"
            android:textColor="@color/jarvis_text"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Claude API key (easiest way to chat)"
            android:inputType="textPassword"
            android:textColor="@color/jarvis_text"
            android:textColorHint="@color/jarvis_dim" />

        <Button
            android:id="@+id/btnClearKey"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Remove saved API key" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Or use your own backend instead (optional, see SETUP.md):"
            android:textColor="@color/jarvis_dim" />

        <EditText
            android:id="@+id/etUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Backend URL (https://...)"
            android:inputType="textUri"
            android:textColor="@color/jarvis_text"
            android:textColorHint="@color/jarvis_dim" />

        <EditText
            android:id="@+id/etToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Backend access token"
            android:inputType="textPassword"
            android:textColor="@color/jarvis_text"
            android:textColorHint="@color/jarvis_dim" />

        <Button
            android:id="@+id/btnTest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save and test connection" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:text="Language"
            android:textColor="@color/jarvis_text"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgLang"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbEn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="English"
                android:textColor="@color/jarvis_text" />

            <RadioButton
                android:id="@+id/rbNe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="नेपाली"
                android:textColor="@color/jarvis_text" />
        </RadioGroup>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"
            android:text="Save conversation history on this phone"
            android:textColor="@color/jarvis_text" />

        <Button
            android:id="@+id/btnClear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Delete conversation history" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:text="Permissions"
            android:textColor="@color/jarvis_text"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPerms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/jarvis_dim" />

        <Button
            android:id="@+id/btnGrant"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Grant permissions" />

        <Button
            android:id="@+id/btnNotif"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Notification access (open system setting)" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:text="Privacy"
            android:textColor="@color/jarvis_text"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPrivacy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/jarvis_dim" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:text="About JARVIS"
            android:textColor="@color/jarvis_text"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAbout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="32dp"
            android:textColor="@color/jarvis_dim" />
    </LinearLayout>
</ScrollView>
